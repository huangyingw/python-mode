diff --git a/.gitconfig b/.gitconfig
new file mode 100644
--- /dev/null
+++ ./.gitconfig
@@ -0,0 +1,20 @@
+[remote "python-mode"]
+    url = git@github.com:python-mode/python-mode.git
+    fetch = +refs/heads/*:refs/remotes/python-mode/*
+[remote "github"]
+    url = git@github.com:huangyingw/python-mode.git
+    fetch = +refs/heads/*:refs/remotes/github/*
+[push]
+    remote = origin
+    remote = github
+[gsync]
+    remote = python-mode
+    target = python-mode/master
+[branch "dev"]
+    remote = origin
+    merge = refs/heads/dev
+[branch "master"]
+    remote = origin
+    merge = refs/heads/master
+[commit]
+    message = n
diff --git a/autoload/pymode.vim b/autoload/pymode.vim
--- ./autoload/pymode.vim
+++ ./autoload/pymode.vim
@@ -105,6 +105,7 @@ fun! pymode#buffer_pre_write() "{{{
 endfunction "}}}
 
 fun! pymode#buffer_post_write() "{{{
+    call pymode#remove_unuses()
     if g:pymode_rope
         if g:pymode_rope_regenerate_on_write && b:pymode_modified
             call pymode#debug('regenerate')
@@ -131,3 +132,8 @@ fun! pymode#quit() "{{{
         au! * <buffer>
     augroup END
 endfunction "}}}
+
+fun! pymode#remove_unuses() "{{{
+    exec '!~/loadrc/pythonrc/remove-unuses.sh ' . '"' .  expand('%:p') . '"'
+endfunction "}}}
+
